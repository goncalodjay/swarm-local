#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/swarmforge/scripts"

if [[ ! -x "$SCRIPTS_DIR/swarmforge.sh" ]]; then
  echo "SwarmForge local scripts are missing: $SCRIPTS_DIR" >&2
  exit 1
fi

exec "$SCRIPTS_DIR/swarmforge.sh" "$@"
