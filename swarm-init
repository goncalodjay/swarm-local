#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: swarm-init [--languages "Go, Python"] [project-directory]

Installs the local SwarmForge template into a project. No network request,
git clone, package installation, or update check is performed.
EOF
}

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
TEMPLATE_DIR="$SCRIPT_DIR/template"
OPENCODE_MODELS_FILE="$SCRIPT_DIR/opencode-models.tsv"
LANGUAGES=""
TARGET=""
ROLES=(specifier coder refactorer architect)
WORKTREES=(master coder refactorer architect)
declare -A ROLE_AGENTS ROLE_MODELS ROLE_THINKING
SUPPORTED_AGENTS=(claude codex copilot grok opencode pi)

while (($#)); do
  case "$1" in
    --languages|-l)
      [[ $# -ge 2 ]] || { echo "Missing value for $1" >&2; exit 2; }
      LANGUAGES="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      [[ -z "$TARGET" ]] || { echo "Only one project directory is allowed." >&2; exit 2; }
      TARGET="$1"
      shift
      ;;
  esac
done

TARGET="${TARGET:-$PWD}"
TARGET="$(cd "$TARGET" && pwd)"

if [[ -z "$LANGUAGES" ]]; then
  read -r -p "¿Qué lenguajes se utilizarán en este proyecto? (ej.: Go, Python): " LANGUAGES
fi
LANGUAGES="$(printf '%s' "$LANGUAGES" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
[[ -n "$LANGUAGES" ]] || { echo "Debes indicar al menos un lenguaje." >&2; exit 2; }

choose_agent() {
  local role="$1" agent
  while :; do
    read -r -p "Agente para ${role} (${SUPPORTED_AGENTS[*]}): " agent
    agent="${agent,,}"
    for supported in "${SUPPORTED_AGENTS[@]}"; do
      [[ "$agent" == "$supported" ]] && { printf '%s' "$agent"; return; }
    done
    echo "Agente no válido. Opciones: ${SUPPORTED_AGENTS[*]}." >&2
  done
}

choose_model_identifier() {
  local label="$1" value
  while :; do
    read -r -p "$label: " value
    value="$(printf '%s' "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [[ -n "$value" && ! "$value" =~ [[:space:]] ]]; then
      printf '%s' "$value"
      return
    fi
    echo "Indica un identificador de modelo no vacío y sin espacios." >&2
  done
}

choose_opencode_model() {
  local role="$1" selection index=1 id label
  local -a ids=()
  local -a labels=()
  [[ -r "$OPENCODE_MODELS_FILE" ]] || { echo "No se encontró el catálogo local de modelos OpenCode." >&2; exit 1; }
  while IFS=$'\t' read -r id label; do
    [[ -n "$id" && -n "$label" ]] || continue
    ids+=("$id")
    labels+=("$label")
  done < "$OPENCODE_MODELS_FILE"
  ((${#ids[@]} > 0)) || { echo "El catálogo local de modelos OpenCode está vacío." >&2; exit 1; }

  echo "Modelos OpenCode disponibles para ${role}:" >&2
  for index in "${!ids[@]}"; do
    printf '  %d) %s\n' "$((index + 1))" "${labels[$index]}" >&2
  done
  while :; do
    read -r -p "Selecciona el modelo OpenCode para ${role} [1-${#ids[@]}]: " selection
    if [[ "$selection" =~ ^[0-9]+$ ]] && ((selection >= 1 && selection <= ${#ids[@]})); then
      printf '%s' "${ids[$((selection - 1))]}"
      return
    fi
    echo "Selecciona un número entre 1 y ${#ids[@]}." >&2
  done
}

choose_model() {
  local agent="$1" role="$2"
  if [[ "$agent" == "opencode" ]]; then
    choose_opencode_model "$role"
  else
    choose_model_identifier "Modelo para ${role}"
  fi
}

printf '\nConfigura el backend de cada sesión. Modelo y nivel se guardan en swarmforge/swarmforge.conf.\n'
for index in "${!ROLES[@]}"; do
  role="${ROLES[$index]}"
  ROLE_AGENTS[$role]="$(choose_agent "$role")"
  ROLE_MODELS[$role]="$(choose_model "${ROLE_AGENTS[$role]}" "$role")"
  ROLE_THINKING[$role]="$(choose_model_identifier "Thinking/effort para ${role} (off|minimal|low|medium|high|xhigh|max)")"
done

for path in swarm swarmforge; do
  if [[ -e "$TARGET/$path" ]]; then
    echo "No se instaló: $TARGET/$path ya existe." >&2
    echo "No se sobrescriben configuraciones existentes." >&2
    exit 1
  fi
done

cp -R "$TEMPLATE_DIR/swarmforge" "$TARGET/swarmforge"
install -m 0755 "$TEMPLATE_DIR/swarm" "$TARGET/swarm"

config_file="$TARGET/swarmforge/swarmforge.conf"
{
  cat <<'EOF'
# Generated by swarm-init. Format: window <role> <agent> <worktree> [task|batch] [extra-cli-args...]
# Supported agents: claude, codex, copilot, grok, opencode, pi.
# Extra arguments are interpreted by the selected agent CLI.
EOF
  for index in "${!ROLES[@]}"; do
    role="${ROLES[$index]}"
    worktree="${WORKTREES[$index]}"
    agent="${ROLE_AGENTS[$role]}"
    model="${ROLE_MODELS[$role]}"
    thinking="${ROLE_THINKING[$role]}"
    extra="--model $model"
    case "$agent" in
      pi) extra="--provider openai-codex $extra --thinking $thinking" ;;
      claude) extra="$extra --effort $thinking" ;;
      codex) extra="$extra -c model_reasoning_effort=$thinking" ;;
      opencode|copilot|grok) ;;
    esac
    if [[ "$role" == "architect" ]]; then
      printf 'window %s %s %s batch %s\n' "$role" "$agent" "$worktree" "$extra"
    else
      printf 'window %s %s %s %s\n' "$role" "$agent" "$worktree" "$extra"
    fi
  done
} > "$config_file"

mkdir -p "$TARGET/.swarmforge"
cp -R "$TEMPLATE_DIR/toolchain" "$TARGET/.swarmforge/toolchain"

LANGUAGES="$LANGUAGES" python3 - "$TARGET/swarmforge" <<'PY'
import os
import sys
from pathlib import Path

root = Path(sys.argv[1])
placeholder = "{{LANGUAGES}}"
replacements = 0
for path in root.rglob("*"):
    if not path.is_file():
        continue
    text = path.read_text()
    count = text.count(placeholder)
    if count:
        path.write_text(text.replace(placeholder, os.environ["LANGUAGES"]))
        replacements += count
if replacements == 0:
    raise SystemExit(f"No {placeholder} placeholder found below {root}")
PY

ignore_file="$TARGET/.gitignore"
touch "$ignore_file"
for entry in .swarmforge/ .worktrees/; do
  grep -Fqx "$entry" "$ignore_file" || printf '%s\n' "$entry" >> "$ignore_file"
done

printf '\nSwarmForge local instalado en %s\n' "$TARGET"
printf 'Lenguajes configurados: %s\n' "$LANGUAGES"
printf 'Inicia con: cd %q && ./swarm\n' "$TARGET"
