#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: swarm-init [--languages "Go, Python"] [project-directory]
       swarm-init --update [--yes] [--languages "Go, Python"] [project-directory]

Installs the local SwarmForge template into a project. No network request,
git clone, package installation, or update check is performed.

--update brings an existing installation to this template's version:
  - Replaces everything the template owns: swarmforge/scripts, the role
    prompts the template ships (swarmforge/roles/*.prompt), the constitution,
    the swarm launchers, the TUI binary and the toolchain. Appends
    .swarmforge/ and .worktrees/ to .gitignore if missing.
  - Reconciles swarmforge/swarmforge.conf: keeps your agent/model rows for
    roles the template knows, asks (wizard) only for roles the template added,
    and removes roles the template no longer has. The previous file is saved
    as swarmforge.conf.bak (timestamped if one already exists).
  - Before touching anything it checks for a running swarm, uncommitted
    changes in the files it would overwrite, and dirty worktrees. If anything
    is at risk it lists it and asks for confirmation; on yes it stops the
    swarm and copies the at-risk files to .swarmforge/backup-<timestamp>/.
  - Without a terminal it aborts at that point unless --yes is given.
--yes, -y  accept the update confirmation (needed when there is no terminal).
EOF
}

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
TEMPLATE_DIR="$SCRIPT_DIR/template"
PROVIDER_MODELS_FILE="$SCRIPT_DIR/provider-models.tsv"
LANGUAGES=""
TARGET=""
UPDATE=0
ASSUME_YES=0
ROLES=(specifier coder reviewer architect)
WORKTREES=(master coder reviewer architect)
declare -A ROLE_AGENTS ROLE_PROVIDERS ROLE_MODEL_IDS ROLE_MODEL_LABELS ROLE_THINKING
SUPPORTED_AGENTS=(claude codex copilot grok hermes kiro-cli opencode pi)
# Flags de auto-aprobación por backend. Pi no pide permisos por herramienta; no necesita flag.
declare -A AUTO_APPROVE_FLAGS=(
  [claude]="--dangerously-skip-permissions"
  [codex]="--dangerously-bypass-approvals-and-sandbox"
  [copilot]="--allow-all"
  [grok]="--permission-mode bypassPermissions"
  [hermes]="--yolo"
  [kiro-cli]="--trust-all-tools"
  [opencode]="--auto"
)

while (($#)); do
  case "$1" in
  --languages | -l)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 2
    }
    LANGUAGES="$2"
    shift 2
    ;;
  --update | -u)
    UPDATE=1
    shift
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
  *)
    [[ -z "$TARGET" ]] || {
      echo "Only one project directory is allowed." >&2
      exit 2
    }
    TARGET="$1"
    shift
    ;;
  esac
done

TARGET="${TARGET:-$PWD}"
TARGET="$(cd "$TARGET" && pwd)"

# Colores/limpieza de pantalla para la experiencia de menú.
if command -v tput >/dev/null 2>&1 && [[ -t 2 ]]; then
  BOLD="$(tput bold 2>/dev/null || true)"
  DIM="$(tput dim 2>/dev/null || true)"
  REVERSE="$(tput rev 2>/dev/null || true)"
  RESET="$(tput sgr0 2>/dev/null || true)"
else
  BOLD=""
  DIM=""
  REVERSE=""
  RESET=""
fi

# Todas las impresiones de la interfaz de menú van a stderr para no
# contaminar la salida que se redirige a archivos de configuración.
mprintf() {
  printf "$@" >&2
}

clear_screen() {
  if [[ -t 2 ]] && command -v tput >/dev/null 2>&1; then
    tput clear 2>/dev/null || printf '\033[2J\033[H'
  else
    printf '\n'
  fi
}

header() {
  clear_screen >&2
  mprintf '%s%sSwarmForge local — configuración del backend%s\n' "$BOLD" "$REVERSE" "$RESET"
  mprintf '%s%s%s\n\n' "$DIM" "$1" "$RESET"
}

# Windows ships python.exe only; python3 may resolve to the Microsoft Store
# stub ("App execution alias"), which prints an error and exits non-zero.
# Resolve a real, runnable Python 3 and cache it in $PYTHON.
find_python() {
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
    PYTHON=python3
    return 0
  fi
  if command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
    PYTHON=python
    return 0
  fi
  PYTHON=""
  return 1
}

# fill_languages <dir>: replace every {{LANGUAGES}} placeholder below <dir>.
fill_languages() {
  find_python || {
    echo "Python 3 is required to fill the {{LANGUAGES}} placeholders." >&2
    return 1
  }
  LANGUAGES="$LANGUAGES" "$PYTHON" - "$1" <<'PY'
import os
import sys
from pathlib import Path

root = Path(sys.argv[1])
placeholder = "{{LANGUAGES}}"
replacements = 0
for path in root.rglob("*"):
    if not path.is_file():
        continue
    try:
        text = path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, OSError):
        # Binary or unreadable files cannot carry the placeholder.
        continue
    count = text.count(placeholder)
    if count:
        path.write_text(text.replace(placeholder, os.environ["LANGUAGES"]))
        replacements += count
if replacements == 0:
    raise SystemExit(f"No {placeholder} placeholder found below {root}")
PY
}

TUI_BUNDLE_SOURCE="$SCRIPT_DIR/tui/dist/swarm-tui"
TUI_INSTALL_REL=".swarmforge/tui/swarm-tui"
# Bun's --compile appends .exe on Windows, and Windows needs that suffix to
# run the binary: keep the suffix everywhere the bundle travels.
if [[ -f "$TUI_BUNDLE_SOURCE.exe" ]]; then
  TUI_BUNDLE_SOURCE="$TUI_BUNDLE_SOURCE.exe"
  TUI_INSTALL_REL="$TUI_INSTALL_REL.exe"
fi

if ((!UPDATE)); then
  if [[ -z "$LANGUAGES" ]]; then
    header ""
    read -r -p "¿Qué lenguajes se utilizarán en este proyecto? (ej.: Go, Python): " LANGUAGES
  fi
  LANGUAGES="$(printf '%s' "$LANGUAGES" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [[ -n "$LANGUAGES" ]] || {
    echo "Debes indicar al menos un lenguaje." >&2
    exit 2
  }
fi

choose_agent() {
  local role="$1" selection
  local -a agents=("${SUPPORTED_AGENTS[@]}")
  while :; do
    header "Rol: ${role}"
    mprintf '%sSelecciona el agente de código:%s\n' "$BOLD" "$RESET"
    local i=1
    for agent in "${agents[@]}"; do
      mprintf '  %d) %s\n' "$i" "$agent"
      ((i++))
    done
    read -r -p "Agente [1-${#agents[@]}]: " selection
    if [[ "$selection" =~ ^[0-9]+$ ]]; then
      local idx=$((selection - 1))
      if ((idx >= 0 && idx < ${#agents[@]})); then
        printf '%s' "${agents[$idx]}"
        return
      fi
    fi
    mprintf 'Selección no válida.\n'
    sleep 0.5
  done
}

choose_model_identifier() {
  local label="$1" value
  while :; do
    read -r -p "$label: " value
    value="$(printf '%s' "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [[ -n "$value" && ! "$value" =~ [[:space:]] ]]; then
      printf '%s' "$value"
      return
    fi
    mprintf 'Indica un identificador de modelo no vacío y sin espacios.\n'
  done
}

# Devuelve por stdout las líneas del catálogo para un agente, con columnas:
# provider<TAB>provider_label<TAB>model_id<TAB>model_label
_catalog_for_agent() {
  local agent="$1"
  [[ -r "$PROVIDER_MODELS_FILE" ]] || return 0
  awk -F'\t' -v agent="$agent" '
    NR > 1 && $1 == agent && $2 != "" && $4 != "" {
      print $2 "\t" $3 "\t" $4 "\t" $5
    }
  ' "$PROVIDER_MODELS_FILE"
}

# Hermes guarda sus propias credenciales y su propio catálogo de modelos, así
# que el catálogo estático del swarm es una suposición: puede ofrecer un
# provider sin credencial, o uno cuya key expiró (el agente muere con 401
# veinte segundos después de arrancar). El probe le pregunta a Hermes qué
# providers puede usar de verdad y qué modelos expone cada uno.
HERMES_PROBE_DIR=""
HERMES_PROBE_REPORTED=0

_hermes_probe_prepare() {
  [[ -n "$HERMES_PROBE_DIR" ]] && return 0
  local probe="$TEMPLATE_DIR/swarmforge/scripts/swarm_python/hermes_probe.py"
  local py=""
  # Windows only ships python.exe; python3 may resolve to the Microsoft Store
  # stub, which prints an error and exits non-zero.
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
    py="python3"
  elif command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
    py="python"
  fi
  HERMES_PROBE_DIR="$(mktemp -d)"
  if [[ -z "$py" || ! -f "$probe" ]]; then
    mprintf 'No se pudo consultar Hermes (falta python3 o el probe); se usa el catálogo estático.\n'
    return 1
  fi
  if ! "$py" "$probe" --catalog --report --static-catalog "$PROVIDER_MODELS_FILE" \
    >"$HERMES_PROBE_DIR/catalog" 2>"$HERMES_PROBE_DIR/report"; then
    mprintf 'Hermes no devolvió ningún provider utilizable; se usa el catálogo estático.\n'
    return 0
  fi
  # El estado de `hermes auth list` es el ÚLTIMO intento fallido, no la salud
  # de la credencial: sobrevive al reemplazo de la key. La única verdad es una
  # llamada real, así que la pedimos antes de ofrecer los providers.
  local answer=""
  read -r -p "¿Verificamos los providers de Hermes con una llamada real? (s/N) [n]: " answer
  if [[ "$answer" =~ ^(s|si|sí|y|yes)$ ]]; then
    mprintf 'Verificando (una llamada por provider, puede tardar)...\n'
    if ! "$py" "$probe" --catalog --report --verify --static-catalog "$PROVIDER_MODELS_FILE" \
      >"$HERMES_PROBE_DIR/catalog" 2>"$HERMES_PROBE_DIR/report"; then
      mprintf 'Ningún provider respondió bien; se usa el catálogo estático.\n'
    fi
  fi
  return 0
}

_hermes_print_report() {
  [[ "$HERMES_PROBE_REPORTED" == "1" ]] && return 0
  [[ -s "${HERMES_PROBE_DIR:-}/report" ]] || return 0
  HERMES_PROBE_REPORTED=1
  mprintf '%sCredenciales de Hermes detectadas:%s\n' "$BOLD" "$RESET"
  local line provider state label detail credential
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if [[ "$line" != *$'\t'* ]]; then
      mprintf '  ! %s\n' "$line"
      continue
    fi
    IFS=$'\t' read -r provider state label detail credential <<<"$line"
    [[ -n "$provider" ]] || continue
    case "$state" in
      ok)
        mprintf '  ✓ %-22s %s\n' "$provider" "$label"
        ;;
      verified)
        mprintf '  ✓ %-22s %s (%s)\n' "$provider" "$label" "$detail"
        ;;
      suspect)
        mprintf '  ~ %-22s %s (sin verificar: %s)\n' "$provider" "$label" "$detail"
        ;;
      failed)
        mprintf '  ! %-22s %s (credencial caída: %s)\n' "$provider" "$label" "$detail"
        [[ -n "$credential" ]] && mprintf '      credencial activa: %s\n' "$credential"
        mprintf '      re-autenticá con: hermes auth add %s --type api-key\n' "$provider"
        mprintf '      o cambiás la activa con: hermes auth priority %s <id> 0\n' "$provider"
        mprintf '      o la borrás con: hermes auth remove %s <id>\n' "$provider"
        ;;
    esac
  done <"${HERMES_PROBE_DIR}/report"
}

# Every other agent is probed through agent_probe.py: it asks the CLI itself
# whether it is installed and logged in, and which models it can run. When the
# CLI cannot list models (or is missing), the probe returns the static TSV rows,
# so the catalog is never worse than before. Nothing here blocks the wizard.
AGENT_PROBE_DIR=""
declare -A AGENT_PROBE_DONE=()

_agent_probe_prepare() {
  local agent="$1"
  [[ -n "${AGENT_PROBE_DONE[$agent]:-}" ]] && return 0
  AGENT_PROBE_DONE[$agent]=1
  local probe="$TEMPLATE_DIR/swarmforge/scripts/swarm_python/agent_probe.py"
  local py=""
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
    py="python3"
  elif command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
    py="python"
  fi
  [[ -n "$AGENT_PROBE_DIR" ]] || AGENT_PROBE_DIR="$(mktemp -d)"
  if [[ -z "$py" || ! -f "$probe" ]]; then
    mprintf 'No se pudo consultar %s (falta python3 o el probe); se usa el catálogo estático.\n' "$agent"
    return 1
  fi
  mprintf 'Consultando los modelos de %s (puede tardar unos segundos)...\n' "$agent"
  "$py" "$probe" --agent "$agent" --catalog --report --static-catalog "$PROVIDER_MODELS_FILE" \
    >"$AGENT_PROBE_DIR/$agent.catalog" 2>"$AGENT_PROBE_DIR/$agent.report" || true
  return 0
}

_agent_print_report() {
  local agent="$1" file="${AGENT_PROBE_DIR:-}/$1.report"
  [[ -s "$file" ]] || return 0
  local name installed auth source detail hint
  IFS=$'\t' read -r name installed auth source detail hint <"$file"
  hint="${hint%$'\r'}"
  detail="${detail%$'\r'}"
  source="${source%$'\r'}"
  [[ "$detail" == "-" ]] && detail=""
  [[ "$hint" == "-" ]] && hint=""
  case "$auth" in
    not-installed)
      mprintf '  ! %s no está instalado (no se encontró el ejecutable en el PATH); se muestra la lista estática de modelos.\n' "$agent"
      ;;
    missing)
      mprintf '  ! %s no está autenticado%s. Inicia sesión con: %s\n' "$agent" "${detail:+ ($detail)}" "$hint"
      ;;
    ok)
      mprintf '  ✓ %s está autenticado%s\n' "$agent" "${detail:+ ($detail)}"
      ;;
    *)
      mprintf '  ~ No se pudo determinar la autenticación de %s%s\n' "$agent" "${detail:+ ($detail)}"
      ;;
  esac
  if [[ "$source" == "static" && "$installed" == "yes" ]]; then
    mprintf '    Este CLI no ofrece un listado de modelos en vivo; la lista siguiente es estática. Usa "Otro" para ingresar cualquier identificador de modelo.\n'
  fi
}

# _catalog_providers: stdin = catalog lines (provider, provider_label, model_id,
# model_label; tab separated); stdout = "provider<TAB>label", one line per
# provider in first-seen order, even when its rows are not contiguous.
_catalog_providers() {
  local line pkey plabel mid mlabel
  local -A seen=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    IFS=$'\t' read -r pkey plabel mid mlabel <<<"$line"
    [[ -n "$pkey" && -n "$mid" ]] || continue
    [[ -z "${seen[$pkey]:-}" ]] || continue
    seen[$pkey]=1
    printf '%s\t%s\n' "$pkey" "${plabel:-$pkey}"
  done
}

_choose_from_catalog() {
  local agent="$1" role="$2"
  local -a providers=() provider_labels=() model_ids=() model_labels=() model_provider=()
  local -a catalog_lines=()

  if [[ "$agent" == "hermes" ]]; then
    _hermes_probe_prepare || true
    _hermes_print_report
    if [[ -s "${HERMES_PROBE_DIR:-}/catalog" ]]; then
      while IFS= read -r line; do
        [[ -n "$line" ]] && catalog_lines+=("$line")
      done < <(tr -d '\r' <"${HERMES_PROBE_DIR}/catalog")
    fi
  else
    _agent_probe_prepare "$agent" || true
    _agent_print_report "$agent"
    if [[ -s "${AGENT_PROBE_DIR:-}/$agent.catalog" ]]; then
      while IFS= read -r line; do
        [[ -n "$line" ]] && catalog_lines+=("$line")
      done < <(tr -d '\r' <"${AGENT_PROBE_DIR}/$agent.catalog")
    fi
  fi
  if ((${#catalog_lines[@]} == 0)); then
    while IFS= read -r line; do
      [[ -n "$line" ]] && catalog_lines+=("$line")
    done < <(_catalog_for_agent "$agent")
  fi

  local pkey plabel mid mlabel
  if ((${#catalog_lines[@]} > 0)); then
    while IFS=$'\t' read -r pkey plabel; do
      providers+=("$pkey")
      provider_labels+=("$plabel")
    done < <(printf '%s\n' "${catalog_lines[@]}" | _catalog_providers)
  fi
  for line in "${catalog_lines[@]}"; do
    IFS=$'\t' read -r pkey plabel mid mlabel <<<"$line"
    [[ -n "$pkey" && -n "$mid" ]] || continue
    model_ids+=("$mid")
    model_labels+=("${mlabel:-$mid}")
    model_provider+=("$pkey")
  done

  if ((${#providers[@]} == 0)); then
    mprintf 'No hay catálogo local para %s; se pedirá el modelo manualmente.\n' "$agent"
    ROLE_PROVIDERS[$role]="default"
    ROLE_MODEL_IDS[$role]="$(choose_model_identifier "Modelo para ${role}")"
    ROLE_MODEL_LABELS[$role]="${ROLE_MODEL_IDS[$role]}"
    return
  fi

  # Menú de proveedor.
  local provider_selection provider
  while :; do
    header "Rol: ${role} — agente: ${agent}"
    mprintf '%sSelecciona el proveedor:%s\n' "$BOLD" "$RESET"
    local i=1
    for label in "${provider_labels[@]}"; do
      mprintf '  %d) %s\n' "$i" "$label"
      ((i++))
    done
    read -r -p "Proveedor [1-${#providers[@]}]: " provider_selection
    if [[ "$provider_selection" =~ ^[0-9]+$ ]]; then
      local pidx=$((provider_selection - 1))
      if ((pidx >= 0 && pidx < ${#providers[@]})); then
        provider="${providers[$pidx]}"
        break
      fi
    fi
    mprintf 'Selección no válida.\n'
    sleep 0.5
  done

  # Recolectar modelos del proveedor elegido.
  local -a pmodels=() plabels=()
  local idx=0
  for mid in "${model_ids[@]}"; do
    if [[ "${model_provider[$idx]}" == "$provider" ]]; then
      pmodels+=("$mid")
      plabels+=("${model_labels[$idx]}")
    fi
    ((idx += 1))
  done

  # Modelos + opción "Otro".
  local model_selection model_id
  while :; do
    header "Rol: ${role} — proveedor: ${provider}"
    mprintf '%sSelecciona el modelo:%s\n' "$BOLD" "$RESET"
    i=1
    for label in "${plabels[@]}"; do
      mprintf '  %d) %s\n' "$i" "$label"
      ((i++))
    done
    mprintf '  %d) %s\n' "$i" "Otro (ingresar identificador manualmente)"
    read -r -p "Modelo [1-$i]: " model_selection
    if [[ "$model_selection" =~ ^[0-9]+$ ]]; then
      local midx=$((model_selection - 1))
      if ((midx >= 0 && midx < ${#pmodels[@]})); then
        model_id="${pmodels[$midx]}"
        ROLE_MODEL_LABELS[$role]="${plabels[$midx]}"
        break
      elif ((midx == ${#pmodels[@]})); then
        model_id="$(choose_model_identifier "Identificador del modelo para ${role}")"
        ROLE_MODEL_LABELS[$role]="$model_id"
        break
      fi
    fi
    mprintf 'Selección no válida.\n'
    sleep 0.5
  done

  ROLE_PROVIDERS[$role]="$provider"
  ROLE_MODEL_IDS[$role]="$model_id"
}

choose_provider_and_model() {
  local agent="$1" role="$2"
  case "$agent" in
  opencode | hermes | claude | codex | copilot | grok | kiro-cli | pi)
    # The catalog is discovered live per agent; _choose_from_catalog falls
    # back to the static TSV and then to a manual model prompt.
    _choose_from_catalog "$agent" "$role"
    ;;
  *)
    ROLE_PROVIDERS[$role]="default"
    ROLE_MODEL_IDS[$role]="$(choose_model_identifier "Modelo para ${role}")"
    ROLE_MODEL_LABELS[$role]="${ROLE_MODEL_IDS[$role]}"
    ;;
  esac
}

choose_thinking() {
  local role="$1"
  local -a levels=(off minimal low medium high xhigh max)
  local selection
  while :; do
    header "Rol: ${role}"
    mprintf '%sSelecciona el nivel de reasoning/thinking (effort):%s\n' "$BOLD" "$RESET"
    local i=1
    for level in "${levels[@]}"; do
      local marker=""
      [[ "$level" == "medium" ]] && marker=" ${DIM}(predeterminado)${RESET}"
      mprintf '  %d) %s%s\n' "$i" "$level" "$marker"
      ((i++))
    done
    read -r -p "Nivel [1-${#levels[@]}] (Enter para medium): " selection
    selection="${selection:-4}"
    if [[ "$selection" =~ ^[0-9]+$ ]]; then
      local idx=$((selection - 1))
      if ((idx >= 0 && idx < ${#levels[@]})); then
        printf '%s' "${levels[$idx]}"
        return
      fi
    fi
    mprintf 'Selección no válida.\n'
    sleep 0.5
  done
}

choose_auto_approve() {
  while :; do
    read -r -p "¿Auto-aprobar los permisos de herramientas de los agentes? (s/n) [s]: " AUTO_APPROVE
    AUTO_APPROVE="${AUTO_APPROVE:-s}"
    AUTO_APPROVE="${AUTO_APPROVE,,}"
    if [[ "$AUTO_APPROVE" =~ ^(s|si|sí|n|no|y|yes)$ ]]; then
      printf '%s' "$AUTO_APPROVE"
      return
    fi
    mprintf 'Respuesta no válida. Ingresa s (sí) o n (no).\n'
  done
}

# build_config_line <role> <worktree>: render one `window` row from the
# ROLE_* wizard answers and AUTO_APPROVE.
build_config_line() {
  local role="$1" worktree="$2"
  local agent="${ROLE_AGENTS[$role]}"
  local provider="${ROLE_PROVIDERS[$role]}"
  local model_id="${ROLE_MODEL_IDS[$role]}"
  local thinking="${ROLE_THINKING[$role]}"
  local extra="" auto_flag=""
  case "$agent" in
  hermes)
    extra="--provider $provider --model $model_id"
    [[ "$thinking" != "off" ]] && extra="$extra --reasoning $thinking"
    ;;
  opencode)
    extra="--model $provider/$model_id"
    ;;
  pi)
    extra="--model $provider/$model_id --thinking $thinking"
    ;;
  claude)
    extra="--model $model_id"
    [[ "$thinking" != "off" ]] && extra="$extra --effort $thinking"
    ;;
  codex)
    extra="--model $model_id"
    [[ "$thinking" != "off" ]] && extra="$extra -c model_reasoning_effort=$thinking"
    ;;
  copilot | grok | kiro-cli)
    extra="--model $model_id"
    ;;
  esac
  if [[ "$AUTO_APPROVE" =~ ^(s|si|sí|y|yes)$ ]]; then
    auto_flag="${AUTO_APPROVE_FLAGS[$agent]:-}"
    [[ -n "$auto_flag" ]] && extra="$extra $auto_flag"
  fi
  if [[ "$role" == "architect" ]]; then
    printf 'window %s %s %s batch %s' "$role" "$agent" "$worktree" "$extra"
  else
    printf 'window %s %s %s %s' "$role" "$agent" "$worktree" "$extra"
  fi
}

# ---------------------------------------------------------------------------
# --update: bring an existing installation to this template's version.
# ---------------------------------------------------------------------------

# True when we can ask the user something (stdin is a terminal). The env var
# lets automated tests drive the prompt through a pipe.
can_prompt() {
  [[ -t 0 || "${SWARMFORGE_ASSUME_TTY:-0}" == "1" ]]
}

is_yes() {
  local value="${1//$'\r'/}"
  [[ "${value,,}" =~ ^(s|si|sí|y|yes)$ ]]
}

# in_list <needle> [item ...]
in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Roles shipped by the template = the role prompt files it carries.
template_roles() {
  local file
  for file in "$TEMPLATE_DIR"/swarmforge/roles/*.prompt; do
    [[ -e "$file" ]] || continue
    basename "$file" .prompt
  done
}

# backup_copy <path-relative-to-TARGET> <backup-dir>: copy, never move.
backup_copy() {
  local rel="$1" dest="$2/$1"
  [[ -e "$TARGET/$rel" ]] || return 0
  mkdir -p "$(dirname "$dest")"
  cp -pR "$TARGET/$rel" "$dest"
}

stop_running_swarm() {
  local session="" id
  bash "$TEMPLATE_DIR/swarmforge/scripts/stop_handoff_daemon.sh" "$TARGET" >/dev/null 2>&1 || true
  [[ -f "$TARGET/.swarmforge/herdr-session" ]] && session="$(tr -d '\r\n' <"$TARGET/.swarmforge/herdr-session")"
  if [[ -n "$session" ]] && command -v herdr >/dev/null 2>&1; then
    for id in "${UPDATE_WORKSPACES[@]}"; do
      herdr --session "$session" workspace close "$id" >/dev/null 2>&1 || true
    done
  fi
}

# replace_dir <src> <dest>: swap dest for a fresh copy of src without ever
# leaving dest missing or half-copied. dest is renamed to dest.old, src is
# copied in, and dest.old is only deleted once the copy succeeded. On any
# failure dest.old is restored.
replace_dir() {
  local src="$1" dest="$2" old="$2.old"
  rm -rf "$old"
  if [[ -e "$dest" ]] && ! mv "$dest" "$old"; then
    echo "No se pudo mover $dest a un respaldo temporal (¿hay un proceso usándolo?). No se modificó nada." >&2
    return 1
  fi
  if ! cp -R "$src" "$dest"; then
    rm -rf "$dest"
    if [[ -e "$old" ]]; then mv "$old" "$dest" || true; fi
    echo "No se pudo copiar la versión nueva de $dest; se restauró la anterior." >&2
    return 1
  fi
  rm -rf "$old"
}

# install_owned_files <stage> <state-dir>: replace everything the template owns.
install_owned_files() {
  local stage="$1" state="$2" role
  replace_dir "$stage/swarmforge/scripts" "$TARGET/swarmforge/scripts" || return 1
  mkdir -p "$TARGET/swarmforge/constitution" "$TARGET/swarmforge/roles" || return 1
  cp -R "$stage/swarmforge/constitution/." "$TARGET/swarmforge/constitution/" || return 1
  cp "$stage/swarmforge/constitution.prompt" "$TARGET/swarmforge/constitution.prompt" || return 1
  for role in "${tmpl_roles[@]}"; do
    cp "$stage/swarmforge/roles/$role.prompt" "$TARGET/swarmforge/roles/$role.prompt" || return 1
  done
  install -m 0755 "$TEMPLATE_DIR/swarm" "$TARGET/swarm" || return 1
  install -m 0755 "$TEMPLATE_DIR/swarm.cmd" "$TARGET/swarm.cmd" || return 1
  mkdir -p "$state" || return 1
  replace_dir "$TEMPLATE_DIR/toolchain" "$state/toolchain" || return 1
}

# pid_alive <pid>: is that process running? Python's os.getpid() on Windows
# yields a native Windows PID that Git Bash's `kill -0` cannot see, so ask
# tasklist there and keep `kill -0` on POSIX.
pid_alive() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  case "$(uname -s 2>/dev/null)" in
    MINGW* | MSYS* | CYGWIN*)
      if command -v tasklist >/dev/null 2>&1; then
        tasklist //FI "PID eq $pid" //FO CSV //NH 2>/dev/null | tr -d '\r' | grep -Fq -- ",\"$pid\"," && return 0
        return 1
      fi
      kill -0 "$pid" 2>/dev/null || kill -0 -W "$pid" 2>/dev/null
      ;;
    *)
      kill -0 "$pid" 2>/dev/null
      ;;
  esac
}

run_update() {
  local conf="$TARGET/swarmforge/swarmforge.conf"
  local state="$TARGET/.swarmforge"
  local ts answer=""
  ts="$(date +%Y%m%d-%H%M%S)-$$"

  [[ -f "$conf" ]] || {
    echo "No se actualizó: $TARGET no tiene una instalación de SwarmForge." >&2
    return 1
  }
  if [[ -z "$LANGUAGES" ]]; then
    LANGUAGES="$(sed -n 's/^- Project languages: \(.*\)\.$/\1/p' \
      "$TARGET/swarmforge/constitution/articles/project.prompt" 2>/dev/null | head -n 1)"
  fi
  [[ -n "$LANGUAGES" ]] || {
    echo "No se pudieron detectar los lenguajes; pásalos con --languages." >&2
    return 2
  }
  find_python || {
    echo "Se requiere Python 3 para actualizar." >&2
    return 1
  }

  # --- 1. Reconcile roles: template vs. current swarmforge.conf -------------
  local -a tmpl_roles=() conf_roles=() stale_roles=() new_roles=()
  local -A stale_worktree=()
  local line kw role agent wt rest
  mapfile -t tmpl_roles < <(template_roles | tr -d '\r')
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*window[[:space:]]+ ]] || continue
    read -r kw role agent wt rest <<<"$line"
    conf_roles+=("$role")
    if ! in_list "$role" "${tmpl_roles[@]}"; then
      stale_roles+=("$role")
      stale_worktree[$role]="$wt"
    fi
  done <"$conf"
  for role in "${tmpl_roles[@]}"; do
    in_list "$role" "${conf_roles[@]}" || new_roles+=("$role")
  done

  if ((${#new_roles[@]} > 0)) && ! can_prompt; then
    echo "No se actualizó: la plantilla agrega roles (${new_roles[*]}) y hay que elegir su agente/modelo," >&2
    echo "pero no hay terminal interactiva. Ejecuta la actualización desde una terminal." >&2
    return 1
  fi

  # --- 2. Safety check: what could be lost? --------------------------------
  local -a owned=(swarmforge/scripts swarmforge/constitution.prompt swarmforge/constitution swarm swarm.cmd)
  for role in "${tmpl_roles[@]}"; do
    owned+=("swarmforge/roles/$role.prompt")
  done

  local -a dirty_files=() dirty_worktrees=()
  local git_unknown=0
  if git -C "$TARGET" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$TARGET" rev-parse --verify -q HEAD >/dev/null 2>&1; then
      mapfile -t dirty_files < <(
        {
          git -C "$TARGET" diff --relative --name-only HEAD -- "${owned[@]}" 2>/dev/null || true
          git -C "$TARGET" ls-files -o --exclude-standard -- "${owned[@]}" 2>/dev/null || true
          # Untracked files that .gitignore hides are just as lost on replace.
          git -C "$TARGET" ls-files -o -i --exclude-standard -- "${owned[@]}" 2>/dev/null || true
        } | tr -d '\r' | grep -v '__pycache__/' | grep -v '^$' | sort -u || true
      )
    else
      git_unknown=1
    fi
    local wt_dir
    if [[ -d "$TARGET/.worktrees" ]]; then
      for wt_dir in "$TARGET"/.worktrees/*/; do
        [[ -e "${wt_dir}.git" ]] || continue
        if [[ -n "$(git -C "$wt_dir" status --porcelain 2>/dev/null)" ]]; then
          dirty_worktrees+=("$(basename "$wt_dir")")
        fi
      done
    fi
  else
    git_unknown=1
  fi

  UPDATE_WORKSPACES=()
  local swarm_running=0 running_detail=""
  if [[ -f "$state/roles.tsv" ]]; then
    mapfile -t UPDATE_WORKSPACES < <(awk -F'\t' '{ sub(/\r$/, "", $NF); if ($NF != "") print $NF }' "$state/roles.tsv")
  fi
  local pid=""
  [[ -f "$state/daemon/handoffd.pid" ]] && pid="$(tr -d '\r\n' <"$state/daemon/handoffd.pid")"
  if pid_alive "$pid"; then
    swarm_running=1
    running_detail="daemon de handoffs (pid $pid)"
  fi
  if ((!swarm_running)) && [[ -f "$state/herdr-session" ]] && command -v herdr >/dev/null 2>&1 \
    && ((${#UPDATE_WORKSPACES[@]} > 0)); then
    local hsession hout id
    hsession="$(tr -d '\r\n' <"$state/herdr-session")"
    if hout="$(herdr --session "$hsession" workspace list 2>/dev/null)"; then
      for id in "${UPDATE_WORKSPACES[@]}"; do
        if printf '%s' "$hout" | grep -qw -- "$id"; then
          swarm_running=1
          running_detail="sesión herdr $hsession"
          break
        fi
      done
    fi
  fi

  local at_risk=0
  if ((swarm_running || git_unknown || ${#dirty_files[@]} > 0 ||${#dirty_worktrees[@]} > 0 || ${#stale_roles[@]} > 0)); then
    at_risk=1
  fi

  if ((at_risk)); then
    mprintf '\n%sAntes de actualizar hay que revisar lo siguiente:%s\n' "$BOLD" "$RESET"
    if ((swarm_running)); then
      mprintf '\n  El swarm está en ejecución (%s). Se detendrá para actualizar.\n' "$running_detail"
    fi
    if ((git_unknown)); then
      mprintf '\n  No se pudo comprobar el estado de git (no es un repositorio o aún no tiene commits):\n'
      mprintf '  los archivos de SwarmForge podrían tener cambios locales que se perderían.\n'
    fi
    if ((${#dirty_files[@]} > 0)); then
      mprintf '\n  Archivos con cambios sin commit que la actualización sobrescribirá:\n'
      for line in "${dirty_files[@]}"; do mprintf '    - %s\n' "$line"; done
    fi
    if ((${#dirty_worktrees[@]} > 0)); then
      mprintf '\n  Worktrees con cambios sin commit (no se tocan, pero los agentes se reinician):\n'
      for line in "${dirty_worktrees[@]}"; do mprintf '    - .worktrees/%s\n' "$line"; done
    fi
    if ((${#stale_roles[@]} > 0)); then
      mprintf '\n  Roles que la plantilla ya no tiene (se quitarán de swarmforge.conf):\n'
      for role in "${stale_roles[@]}"; do mprintf '    - %s\n' "$role"; done
    fi
    mprintf '\n  Esos cambios se perderían o quedarían inconsistentes. Se recomienda hacer commit\n'
    mprintf '  de tu trabajo antes de continuar (git add -A && git commit).\n'
    mprintf '  Si continúas, se detiene el swarm y se copian los archivos de SwarmForge a\n'
    mprintf '  .swarmforge/backup-%s/ antes de reemplazar nada.\n\n' "$ts"

    if ((ASSUME_YES)); then
      mprintf 'Opción --yes indicada: se continúa sin preguntar.\n'
    elif can_prompt; then
      read -r -p "¿Continuar y reiniciar todo? (s/N): " answer || true
      if ! is_yes "$answer"; then
        mprintf 'Actualización cancelada. No se modificó nada.\n'
        return 1
      fi
    else
      echo "Actualización cancelada: no hay terminal para confirmar. No se modificó nada." >&2
      echo "Haz commit de tus cambios y vuelve a ejecutar, o usa --yes para continuar." >&2
      return 1
    fi
  fi

  # --- 3. Stop the swarm and back up everything at risk ---------------------
  if ((swarm_running)); then
    mprintf 'Deteniendo el swarm...\n'
    stop_running_swarm
  fi

  # Always copy every owned path first, whatever git says (untracked, ignored
  # or non-git installs included). A failed copy aborts before anything is replaced.
  local backup_dir="$state/backup-$ts" n=1
  while [[ -e "$backup_dir" ]]; do
    backup_dir="$state/backup-$ts-$n"
    ((n += 1))
  done
  local backed_up=0 stale_prompt rel
  for rel in "${owned[@]}" .swarmforge/toolchain; do
    if ! backup_copy "$rel" "$backup_dir"; then
      echo "No se pudo respaldar $rel en $backup_dir. No se modificó nada." >&2
      return 1
    fi
    [[ -e "$TARGET/$rel" ]] && backed_up=1
  done
  for role in "${stale_roles[@]}"; do
    for stale_prompt in "$state/prompts/$role.md" "$state/prompts/$role.sh"; do
      if [[ -e "$stale_prompt" ]]; then
        if ! backup_copy ".swarmforge/prompts/$(basename "$stale_prompt")" "$backup_dir"; then
          echo "No se pudo respaldar $stale_prompt. No se modificó nada." >&2
          return 1
        fi
        backed_up=1
      fi
    done
  done

  # --- 4. Ask for the agent/model of roles the template added ---------------
  if ((${#new_roles[@]} > 0)); then
    mprintf '\nLa plantilla agrega roles nuevos: %s. Configura su backend.\n' "${new_roles[*]}"
    AUTO_APPROVE="$(choose_auto_approve)"
    for role in "${new_roles[@]}"; do
      ROLE_AGENTS[$role]="$(choose_agent "$role")"
      choose_provider_and_model "${ROLE_AGENTS[$role]}" "$role"
      ROLE_THINKING[$role]="$(choose_thinking "$role")"
    done
  fi

  # --- 5. Replace everything template-owned ---------------------------------
  local stage
  stage="$(mktemp -d)"
  mkdir -p "$stage/swarmforge/roles"
  cp -R "$TEMPLATE_DIR/swarmforge/scripts" "$stage/swarmforge/scripts"
  cp -R "$TEMPLATE_DIR/swarmforge/constitution" "$stage/swarmforge/constitution"
  cp "$TEMPLATE_DIR/swarmforge/constitution.prompt" "$stage/swarmforge/constitution.prompt"
  for role in "${tmpl_roles[@]}"; do
    cp "$TEMPLATE_DIR/swarmforge/roles/$role.prompt" "$stage/swarmforge/roles/$role.prompt"
  done
  find "$stage" -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true
  fill_languages "$stage" || {
    rm -rf "$stage"
    return 1
  }

  # Every step reports failure explicitly (set -e is not reliable inside
  # functions called from `||`), so a failure never leaves a half-installed tree.
  if ! install_owned_files "$stage" "$state"; then
    rm -rf "$stage"
    echo "La actualización falló a mitad de camino. Tus archivos originales están en $backup_dir/" >&2
    echo "Revisa los mensajes anteriores y vuelve a ejecutar la actualización." >&2
    return 1
  fi
  rm -rf "$stage"
  local tui_updated=0
  if [[ -f "$TUI_BUNDLE_SOURCE" ]]; then
    mkdir -p "$(dirname "$TARGET/$TUI_INSTALL_REL")"
    install -m 0755 "$TUI_BUNDLE_SOURCE" "$TARGET/$TUI_INSTALL_REL"
    tui_updated=1
  fi

  local ignore_file="$TARGET/.gitignore" entry
  touch "$ignore_file"
  for entry in .swarmforge/ .worktrees/; do
    grep -Fqx "$entry" "$ignore_file" || printf '%s\n' "$entry" >>"$ignore_file"
  done

  # --- 6. Reconcile swarmforge.conf (agent/model choices) -------------------
  local conf_bak="" conf_changed=0 new_wt
  if ((${#stale_roles[@]} > 0 || ${#new_roles[@]} > 0)); then
    conf_changed=1
    conf_bak="$conf.bak"
    [[ -e "$conf_bak" ]] && conf_bak="$conf.bak.$ts"
    cp -p "$conf" "$conf_bak"
    local tmp_conf
    tmp_conf="$(mktemp)"
    {
      while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*window[[:space:]]+ ]]; then
          read -r kw role agent wt rest <<<"${line%$'\r'}"
          in_list "$role" "${stale_roles[@]}" && continue
        fi
        printf '%s\n' "$line"
      done <"$conf"
      if ((${#new_roles[@]} > 0)); then
        printf '# Added by swarm-init --update (roles new in the template).\n'
        for role in "${new_roles[@]}"; do
          new_wt="$role"
          [[ "$role" == "specifier" ]] && new_wt="master"
          build_config_line "$role" "$new_wt"
          printf '\n'
        done
      fi
    } >"$tmp_conf"
    cat "$tmp_conf" >"$conf"
    rm -f "$tmp_conf"
  fi

  # --- 7. Stale state: only for roles that left the template ----------------
  if ((${#stale_roles[@]} > 0)); then
    for role in "${stale_roles[@]}"; do
      rm -f "$state/prompts/$role.md" "$state/prompts/$role.sh"
      if [[ -f "$state/roles.tsv" ]]; then
        awk -F'\t' -v r="$role" '$1 != r' "$state/roles.tsv" >"$state/roles.tsv.new" && mv "$state/roles.tsv.new" "$state/roles.tsv"
      fi
      if [[ -f "$state/sessions.tsv" ]]; then
        awk -F'\t' -v r="$role" '$2 != r' "$state/sessions.tsv" >"$state/sessions.tsv.new" && mv "$state/sessions.tsv.new" "$state/sessions.tsv"
      fi
    done
    if [[ -f "$state/agents.json" ]]; then
      "$PYTHON" - "$state/agents.json" "${stale_roles[@]}" <<'PY' || mprintf 'Aviso: no se pudo limpiar agents.json.\n'
import json
import sys

path = sys.argv[1]
stale = set(sys.argv[2:])
with open(path, encoding="utf-8") as handle:
    data = json.load(handle)
if isinstance(data, dict):
    for role in stale:
        data.pop(role, None)
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
PY
    fi
  fi

  # --- 8. Worktrees of stale roles: never delete anything dirty -------------
  local -a wt_notes=()
  local wt_path branch
  for role in "${stale_roles[@]}"; do
    wt="${stale_worktree[$role]:-}"
    [[ -n "$wt" && "$wt" != "master" && -d "$TARGET/.worktrees/$wt" ]] || continue
    wt_path="$TARGET/.worktrees/$wt"
    branch="$(git -C "$wt_path" branch --show-current 2>/dev/null || true)"
    if in_list "$wt" "${dirty_worktrees[@]}"; then
      wt_notes+=("Se conserva .worktrees/$wt (tiene cambios sin commit). Cuando lo resuelvas: git worktree remove .worktrees/$wt${branch:+ && git branch -d $branch}")
    elif can_prompt && ((!ASSUME_YES)); then
      read -r -p "¿Eliminar el worktree limpio .worktrees/$wt${branch:+ y la rama $branch}? (s/N): " answer || true
      if is_yes "$answer"; then
        if git -C "$TARGET" worktree remove ".worktrees/$wt" 2>/dev/null; then
          wt_notes+=("Worktree .worktrees/$wt eliminado.")
          if [[ -n "$branch" ]]; then
            git -C "$TARGET" branch -d "$branch" >/dev/null 2>&1 \
              && wt_notes+=("Rama $branch eliminada.") \
              || wt_notes+=("La rama $branch no se eliminó (tiene commits sin fusionar). Para forzar: git branch -D $branch")
          fi
        else
          wt_notes+=("No se pudo eliminar .worktrees/$wt. Manual: git worktree remove .worktrees/$wt${branch:+ && git branch -d $branch}")
        fi
      else
        wt_notes+=("Se conserva .worktrees/$wt. Para quitarlo: git worktree remove .worktrees/$wt${branch:+ && git branch -d $branch}")
      fi
    else
      wt_notes+=("Se conserva .worktrees/$wt. Para quitarlo: git worktree remove .worktrees/$wt${branch:+ && git branch -d $branch}")
    fi
  done

  # --- 9. Summary -----------------------------------------------------------
  mprintf '\n%sSwarmForge actualizado en %s%s\n' "$BOLD" "$TARGET" "$RESET"
  mprintf '\nReemplazado (propiedad de la plantilla):\n'
  mprintf '  - swarmforge/scripts, swarmforge/constitution.prompt y swarmforge/constitution/\n'
  mprintf '  - prompts de roles: %s\n' "${tmpl_roles[*]}"
  mprintf '  - swarm, swarm.cmd y .swarmforge/toolchain\n'
  if ((tui_updated)); then
    mprintf '  - binario del TUI (%s)\n' "$TUI_INSTALL_REL"
  else
    mprintf '  - binario del TUI: no encontrado en %s; se dejó el existente\n' "$TUI_BUNDLE_SOURCE"
  fi
  mprintf '\nConservado:\n'
  mprintf '  - estado en .swarmforge (handoffs, logs, notify, sesiones) y worktrees\n'
  if ((conf_changed)); then
    mprintf '  - filas de swarmforge.conf de los roles vigentes\n'
  else
    mprintf '  - swarmforge/swarmforge.conf (sin cambios)\n'
  fi
  if ((${#new_roles[@]} > 0)); then
    mprintf '\nRoles nuevos configurados: %s\n' "${new_roles[*]}"
  fi
  if ((${#stale_roles[@]} > 0)); then
    mprintf '\nRoles obsoletos quitados de swarmforge.conf: %s\n' "${stale_roles[*]}"
    for role in "${stale_roles[@]}"; do
      if [[ -f "$TARGET/swarmforge/roles/$role.prompt" ]]; then
        mprintf '  Aviso: swarmforge/roles/%s.prompt se conserva (no lo incluye la plantilla); revísalo o bórralo.\n' "$role"
      fi
    done
    for line in "${wt_notes[@]}"; do mprintf '  %s\n' "$line"; done
  fi
  mprintf '\nCopias de seguridad:\n'
  if ((conf_changed)); then mprintf '  - %s\n' "$conf_bak"; fi
  if ((backed_up)); then mprintf '  - %s/\n' "$backup_dir"; fi
  if ((!conf_changed && !backed_up)); then mprintf '  - ninguna era necesaria\n'; fi
  mprintf '\nSiguiente paso: revisa los cambios con git status, haz commit y ejecuta ./swarm.\n'
  return 0
}

if ((UPDATE)); then
  run_update
  exit $?
fi

AUTO_APPROVE="$(choose_auto_approve)"

mprintf '\nConfigura el backend de cada sesión. Modelo y nivel se guardan en swarmforge/swarmforge.conf.\n'
for index in "${!ROLES[@]}"; do
  role="${ROLES[$index]}"
  ROLE_AGENTS[$role]="$(choose_agent "$role")"
  choose_provider_and_model "${ROLE_AGENTS[$role]}" "$role"
  ROLE_THINKING[$role]="$(choose_thinking "$role")"
done

for path in swarm swarmforge; do
  if [[ -e "$TARGET/$path" ]]; then
    echo "No se instaló: $TARGET/$path ya existe." >&2
    echo "No se sobrescriben configuraciones existentes." >&2
    echo "Para actualizar solo el código usa: swarm-init --update $TARGET" >&2
    exit 1
  fi
done

# install_tui_bundle <source-bundle> <project-root> [install-rel]
# Pure-bash replacement for tui/src/install.ts: copy a compiled TUI binary
# into <project-root>/<install-rel> and chmod it. Keeps swarm-init Node-free
# on the destination; the install.ts entry stays for test compatibility.
install_tui_bundle() {
  local source_bundle="$1"
  local project_root="$2"
  local install_rel="${3:-.swarmforge/tui/swarm-tui}"
  [[ -f "$source_bundle" ]] || {
    echo "install_tui_bundle: bundle not found at $source_bundle" >&2
    return 1
  }
  local target="$project_root/$install_rel"
  if [[ -e "$target" ]]; then
    echo "install_tui_bundle: refusing to overwrite existing $target" >&2
    return 1
  fi
  mkdir -p "$(dirname "$target")" || return 1
  cp "$source_bundle" "$target" || return 1
  chmod 0755 "$target" || return 1
  echo "Installed TUI bundle at $target"
}

if [[ ! -f "$TUI_BUNDLE_SOURCE" ]]; then
  echo "No se instaló: no se encontró el binario del TUI en $TUI_BUNDLE_SOURCE." >&2
  echo "Compílalo una vez con: (cd tui && npm install && npm run build)" >&2
  exit 1
fi
if ! install_tui_bundle "$TUI_BUNDLE_SOURCE" "$TARGET" "$TUI_INSTALL_REL"; then
  echo "No se instaló: falló la copia del binario del TUI." >&2
  exit 1
fi

cp -R "$TEMPLATE_DIR/swarmforge" "$TARGET/swarmforge"
# Python leaves __pycache__ behind whenever anything imports the template's
# modules. Those are build artifacts of the source tree, never part of an
# installation, and their .pyc files are not text.
find "$TARGET/swarmforge" -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true
install -m 0755 "$TEMPLATE_DIR/swarm" "$TARGET/swarm"
install -m 0755 "$TEMPLATE_DIR/swarm.cmd" "$TARGET/swarm.cmd"

declare -a CONFIG_LINES=()
for index in "${!ROLES[@]}"; do
  CONFIG_LINES+=("$(build_config_line "${ROLES[$index]}" "${WORKTREES[$index]}")")
done

config_file="$TARGET/swarmforge/swarmforge.conf"
{
  cat <<'EOF'
# Generated by swarm-init. Format: window <role> <agent> <worktree> [task|batch] [extra-cli-args...]
# Supported agents: claude, codex, copilot, grok, hermes, kiro-cli, opencode, pi.
# Extra arguments are interpreted by the selected agent CLI.
EOF
  printf '%s\n' "${CONFIG_LINES[@]}"
} >"$config_file"

mkdir -p "$TARGET/.swarmforge"
cp -R "$TEMPLATE_DIR/toolchain" "$TARGET/.swarmforge/toolchain"

fill_languages "$TARGET/swarmforge"

ignore_file="$TARGET/.gitignore"
touch "$ignore_file"
for entry in .swarmforge/ .worktrees/; do
  grep -Fqx "$entry" "$ignore_file" || printf '%s\n' "$entry" >>"$ignore_file"
done

clear_screen >&2
mprintf '%sInstalación completada%s\n' "$BOLD" "$RESET"
mprintf 'SwarmForge local instalado en %s\n' "$TARGET"
mprintf 'Lenguajes configurados: %s\n' "$LANGUAGES"
mprintf '\nBackends por rol:\n'
for index in "${!ROLES[@]}"; do
  role="${ROLES[$index]}"
  agent="${ROLE_AGENTS[$role]}"
  provider="${ROLE_PROVIDERS[$role]}"
  model_id="${ROLE_MODEL_IDS[$role]}"
  label="${ROLE_MODEL_LABELS[$role]}"
  thinking="${ROLE_THINKING[$role]}"
  mprintf '  %-10s %-8s' "$role" "$agent"
  if [[ "$agent" == "opencode" || "$agent" == "pi" ]]; then
    mprintf ' — %s/%s' "$provider" "$model_id"
  elif [[ "$agent" == "hermes" ]]; then
    mprintf ' — %s / %s' "$provider" "$model_id"
  else
    mprintf ' — %s' "$model_id"
  fi
  mprintf ' (%s, thinking: %s)\n' "$label" "$thinking"
done
if [[ "$AUTO_APPROVE" =~ ^(s|si|sí|y|yes)$ ]]; then
  mprintf '\nPermisos de herramientas: auto-aprobados (editable en swarmforge/swarmforge.conf)\n'
else
  mprintf '\nPermisos de herramientas: con confirmación interactiva\n'
fi
mprintf 'Inicia con: cd %q && ./swarm\n' "$TARGET"
